{
  "name": "airpod-connect",
  "version": "0.1.0",
  "private": true,
  "description": "A warm, minimal Windows companion for AirPods.",
  "author": "Airpod Connect contributors",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "desktop": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:ui": "playwright test",
    "dist:win": "npm run build && electron-builder --win nsis --x64",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "dist:win:portable": "npm run build && electron-builder --win portable --x64 -c.win.signAndEditExecutable=false"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^44.7.0",
    "electron-builder": "^26.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^3.0.5",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.airpodconnect.desktop",
    "productName": "Airpod Connect",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "scripts/bluetooth.ps1",
        "to": "bluetooth.ps1"
      }
    ],
    "win": {
      "target": "nsis",
      "artifactName": "Airpod-Connect-${version}-Setup.${ext}",
      "icon": "public/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "portable": {
      "artifactName": "Airpod-Connect-${version}-Portable.${ext}"
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
